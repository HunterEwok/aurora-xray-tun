Name:       @APP@
Summary:    Xray-core с TUN для VLESS на ОС Аврора
Version:    @VERSION@
Release:    1
License:    MPL-2.0
URL:        https://github.com/XTLS/Xray-core
%global debug_package %{nil}
%define __strip /bin/true
%define _build_id_links none

%description
Xray-core, собранный для ОС Аврора. Запускается от root скриптом vless.sh:
@APP@ run -c xray.json

%install
install -D -m 755 %{_sourcedir}/@APP@ %{buildroot}%{_bindir}/@APP@
install -D -m 644 %{_sourcedir}/@APP@.desktop %{buildroot}%{_datadir}/applications/@APP@.desktop
for s in 86 108 128 172; do install -D -m 644 %{_sourcedir}/icons/$s.png %{buildroot}%{_datadir}/icons/hicolor/${s}x${s}/apps/@APP@.png; done

%files
%defattr(-,root,root,-)
%{_bindir}/@APP@
%{_datadir}/applications/@APP@.desktop
%{_datadir}/icons/hicolor/*/apps/@APP@.png
